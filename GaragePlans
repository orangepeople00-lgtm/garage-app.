<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Garage Plans — Absolute Garage Builders</title>
<style>
:root{--ink:#111;--navy:#0b1f3a;--gold:#c9a227;--bg:#e8edf3}
*{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:#122}
body{display:flex;min-height:100vh}
.sidebar{width:340px;flex:0 0 340px;background:#0b1f3a;color:#e8eef6;overflow:auto;padding:14px 14px 40px}
.sidebar h1{font-size:15px;letter-spacing:.08em;margin:0 0 2px;text-transform:uppercase}
.sidebar .sub{font-size:11px;color:#9bb0c9;margin-bottom:14px}
.sidebar label{display:block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#9bb0c9;margin:8px 0 3px}
.sidebar input,.sidebar select,.sidebar textarea{width:100%;padding:7px 8px;border:1px solid #2a4668;background:#102744;color:#fff;border-radius:6px;font-size:13px}
.sidebar textarea{min-height:70px;resize:vertical}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}
.btns{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
button{border:0;border-radius:7px;padding:8px 10px;font-weight:800;cursor:pointer;font-size:12px}
.btn-gold{background:#c9a227;color:#111}
.btn-white{background:#fff;color:#0b1f3a}
.btn-ghost{background:#163456;color:#dbe7f5;border:1px solid #2a4668}
.codes{margin-top:12px;background:#08182c;border:1px solid #2a4668;border-radius:8px;padding:8px;font-size:11px;line-height:1.35;color:#d5e4f5;white-space:pre-wrap}
.loadbar{display:none;margin-top:8px;background:#163456;border:1px solid #c9a227;border-radius:8px;padding:8px 10px;font-size:12px;color:#ffe9a6}
.loadbar.on{display:block}
.main{flex:1;min-width:0;overflow:auto;padding:16px}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.toolbar h2{margin:0;font-size:18px;color:#0b1f3a}
.sheet-wrap{display:flex;flex-direction:column;gap:18px;align-items:stretch;width:100%}
.sheet-fit{width:100%;overflow:hidden}
.sheet{width:17in;min-height:11in;background:#fff;color:#111;border:1.6px solid #111;box-shadow:0 8px 24px #0002;position:relative;padding:14px 16px 88px;page-break-after:always;transform-origin:top left}
.sheet.letter{width:11in;min-height:8.5in}
.tblock{position:absolute;left:16px;right:16px;bottom:8px;height:72px;border:1.5px solid #111;display:grid;grid-template-columns:160px 1.2fr 230px 140px;font-size:12px;line-height:1.25;background:#fff}
.tblock>div{border-right:1px solid #111;padding:6px 8px}
.tblock>div:last-child{border-right:0}
.logo{font-weight:900;line-height:1.2;font-size:13px}
.logo small{display:block;font-size:9px;letter-spacing:.08em;font-weight:800;margin-top:2px}
.jobtitle{font-weight:800;font-size:13px;letter-spacing:.02em;margin-bottom:3px}
.small{font-size:12px;color:#444}
.warn{color:#8a1c1c;font-weight:700}
.notes-col{font-size:13px;line-height:1.4}
.notes-col h3{margin:10px 0 6px;font-size:15px;letter-spacing:.04em}
.notes-col ul{margin:4px 0 8px;padding-left:18px}
.notes-col li{margin:0 0 4px}
.split{display:grid;grid-template-columns:1.05fr .95fr;gap:10px;align-items:start}
.elevpage{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start;min-height:8.6in}
.caption{text-align:center;font-weight:800;letter-spacing:.06em;font-size:16px;margin-top:6px}
.subcap{text-align:center;font-size:12px;margin-bottom:4px}
.elecbox{border:1.4px solid #111;padding:10px 12px;margin-top:10px}
.detailgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:16px;align-items:start}
.toolbox{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 10px}
.toolbox button{padding:7px 8px}
.draw-host{position:relative}
.overlay{position:absolute;inset:0;pointer-events:none}
.ov{position:absolute;pointer-events:auto;cursor:move;user-select:none}
.ov.gfi{width:42px;height:42px;border:1.6px solid #111;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;letter-spacing:.02em}
.ov.txt{min-width:48px;padding:2px 4px;font-size:12px;font-weight:700;background:transparent;border:0;outline:1px dashed transparent}
.ov.txt:focus,.ov.txt:hover{outline:1px dashed #2563eb;background:#fff8}
.ov.box{border:1.5px solid #111;background:transparent;min-width:40px;min-height:24px}
.ov.line{height:2px;background:#111;min-width:40px}
.ov.sel{outline:2px solid #2563eb}
.sheet [contenteditable="true"]{outline:none}
@media print{
  .toolbox,.loadbar,.no-print{display:none!important}
  .ov.txt{outline:none!important;background:transparent!important}
  .ov.sel{outline:none}
}
@media print{
  @page{size:11in 17in landscape;margin:.35in}
  body{display:block;background:#fff}
  .sidebar,.toolbar,.no-print{display:none!important}
  .main{padding:0;overflow:visible}
  .sheet-fit{overflow:visible;height:auto!important}
  .sheet{box-shadow:none;margin:0;page-break-after:always;transform:none!important;width:17in!important}
  .sheet.letter{width:11in!important;min-height:8.5in!important}
}
@media(max-width:900px){
  body{flex-direction:column}
  .sidebar{width:100%;flex:none;max-height:46vh}
}
</style>
</head>
<body>
<aside class="sidebar">
  <h1>Garage Plans</h1>
  <div class="sub">Permit drawings · Absolute Garage Builders</div>
  <label>Village / City</label>
  <select id="city"></select>
  <div class="row2">
    <div><label>Manual city</label><input id="cityManual" placeholder="If not listed"></div>
    <div><label>County</label><input id="county" readonly></div>
  </div>
  <label>Project / customer</label>
  <input id="customer" placeholder="Customer name">
  <label>Job address</label>
  <input id="address" placeholder="Street address">
  <div class="row2">
    <div><label>PIN / tax ID</label><input id="pin"></div>
    <div><label>Date</label><input id="planDate" type="date"></div>
  </div>
  <div class="row2">
    <div><label>Drawn by</label><select id="rep">
      <option>Ramsey Barakat</option><option>Sam Barakat</option><option>Wally B.</option>
      <option>Tomas</option><option>Tom Bartyzel</option><option>Luis</option>
    </select></div>
    <div><label>Sheet size</label><select id="sheetSize"><option value="tabloid">11×17</option><option value="letter">Letter</option></select></div>
  </div>
  <label>Garage size (ft)</label>
  <div class="row3">
    <input id="width" type="number" step="0.5" value="22" title="Width">
    <input id="depth" type="number" step="0.5" value="24" title="Depth">
    <input id="wallH" type="number" step="0.5" value="8" title="Wall height">
  </div>
  <div class="row3">
    <div><label>Roof</label><select id="roof"><option value="revgable">Reverse gable</option><option value="gable">Gable</option><option value="hip">Hip</option></select></div>
    <div><label>Pitch</label><select id="pitch"><option selected>4/12</option><option>6/12</option><option>7/12</option><option>8/12</option><option>10/12</option><option>12/12</option></select></div>
    <div><label>Snow psf</label><input id="snowLoad" value="30"></div>
  </div>
  <div class="row2">
    <div><label>Siding</label><select id="siding"><option>4" vinyl</option><option>Premium Vinyl</option><option>Hardieboard</option></select></div>
    <div><label>Shingles</label><select id="shingles"><option>25 year fiberglass</option><option>235# asphalt</option><option>Architectural</option><option>3-Tab</option></select></div>
  </div>
  <div class="row2">
    <div><label>Wall sheathing</label><select id="wallSheath"><option>7/16" OSB</option><option>1/2" OSB</option><option>5/8" OSB</option><option>1/2" Plywood</option></select></div>
    <div><label>Roof sheathing</label><select id="roofSheath"><option>7/16" OSB</option><option>1/2" OSB</option><option>5/8" OSB</option></select></div>
  </div>
  <div class="row2">
    <div><label>Eaves / soffit</label><input id="eaves" value='6" fascia / 6" soffit'></div>
    <div><label>Vents</label><input id="vents" value="ridge / mushroom"></div>
  </div>
  <div class="row2">
    <div><label>Gutters</label><select id="gutters"><option>yes</option><option>none</option></select></div>
    <div><label>Apron depth ft</label><input id="apronFt" value="3" title="0 = no apron"></div>
  </div>
  <label>Overhead door</label>
  <div class="row3">
    <input id="ohW" type="number" step="0.5" value="16" title="OH width">
    <input id="ohH" type="number" step="0.5" value="7" title="OH height">
    <select id="ohWall"><option value="front">Front</option><option value="back">Back</option><option value="left">Left</option><option value="right">Right</option></select>
  </div>
  <div class="row2">
    <div><label>OH left return ft</label><input id="ohLeftReturn" type="number" step="0.5" placeholder="auto center"></div>
    <div><label>OH returns</label><input id="returnReadout" readonly placeholder="—"></div>
  </div>
  <label>Slide overhead door (left return)</label>
  <input id="ohSlide" type="range" min="0" max="10" step="0.5" value="3" style="width:100%">
  <div class="row2">
    <div><label>Service door</label><select id="svcWall"><option value="none" selected>None</option><option value="left">Left</option><option value="right">Right</option><option value="back">Back</option><option value="front">Front</option></select></div>
    <div><label>Landing (blank = none)</label><input id="landing" placeholder="e.g. 3x5 or leave blank"></div>
  </div>
  <div class="row2">
    <div><label>Party door wall</label><select id="partyWall"><option value="none" selected>None</option><option value="back">Back</option><option value="front">Front</option><option value="left">Left</option><option value="right">Right</option></select></div>
    <div><label>Party door size W x H</label><input id="partySize" value="6x7" placeholder="6x7"></div>
  </div>
  <div class="row2">
    <div><label>Party left return ft</label><input id="partyLeftReturn" type="number" step="0.5" placeholder="auto center"></div>
    <div><label>Party returns</label><input id="partyReadout" readonly placeholder="—"></div>
  </div>
  <label>Slide party door (left return)</label>
  <input id="partySlide" type="range" min="0" max="10" step="0.5" value="2" style="width:100%">
  <div class="row2">
    <div><label>Window wall</label><select id="winWall"><option value="none" selected>None</option><option value="back">Back</option><option value="left">Left</option><option value="right">Right</option><option value="front">Front</option></select></div>
    <div><label>Window type</label><select id="winType"><option>Single hung</option><option>Slider</option><option>vinyl</option></select></div>
  </div>
  <div class="row2">
    <div><label>Window size</label><input id="winSize" value='24"x36"'></div>
    <div><label># of windows</label><input id="winCount" type="number" min="0" max="6" value="0"></div>
  </div>
  <div class="row2">
    <div><label>GFI / outlets shown</label><input id="gfiCount" type="number" min="0" max="8" value="2"></div>
    <div><label>Lights noted</label><input id="lightCount" type="number" min="0" max="8" value="2"></div>
  </div>
  <label>Setbacks (auto from village)</label>
  <div class="row2"><div><label>House</label><input id="setHouse"></div><div><label>Side</label><input id="setSide"></div></div>
  <div class="row2"><div><label>Rear (alley)</label><input id="setRearA"></div><div><label>Rear (no alley)</label><input id="setRearN"></div></div>
  <div class="row2"><div><label>Corner</label><input id="setCorner"></div><div><label>Front</label><input id="setFront"></div></div>
  <label>Foundation</label>
  <div class="row2">
    <div><label>Footing</label><input id="footing" placeholder='12" x 12"'></div>
    <div><label>Slab</label><input id="slab" placeholder='4" / 6 BAG / WWF'></div>
  </div>
  <label>Electrical notes</label>
  <textarea id="electricNotes">CIRCUITS: (1) 20 AMP. #12 GA. (1) 15 AMP. #14 GA.
CONTAINED IN 1/2" RIGID STEEL CONDUIT
BURIAL DEPTH: 8 INCHES
WIRING: SEPARATE CIRCUITS TO ELECTRICAL PANEL
All outlets tamperproof. GARAGE DISCONNECT at first point of entrance inside garage.</textarea>
  <label>Special project notes</label>
  <textarea id="notes"></textarea>
  <label>Drawing toolbox</label>
  <div class="toolbox no-print">
    <button type="button" class="btn-ghost" onclick="toolAddText()">Add text</button>
    <button type="button" class="btn-ghost" onclick="toolAddRect()">Box</button>
    <button type="button" class="btn-ghost" onclick="toolAddLine()">Line</button>
    <button type="button" class="btn-ghost" onclick="toolAddGfi()">GFI</button>
    <button type="button" class="btn-ghost" onclick="toolUndo()">Undo</button>
    <button type="button" class="btn-ghost" onclick="toolDelete()">Delete</button>
  </div>
  <label>Flags</label>
  <div class="row2">
    <label style="display:flex;gap:6px;align-items:center;text-transform:none;letter-spacing:0;font-size:12px;color:#e8eef6"><input id="flagFirewall" type="checkbox"> Fire wall</label>
    <label style="display:flex;gap:6px;align-items:center;text-transform:none;letter-spacing:0;font-size:12px;color:#e8eef6"><input id="flagShear" type="checkbox"> Brace wall (only if village requires)</label>
  </div>
  <div class="row2">
    <label style="display:flex;gap:6px;align-items:center;text-transform:none;letter-spacing:0;font-size:12px;color:#e8eef6"><input id="flagGutters" type="checkbox" checked> Gutters</label>
    <label style="display:flex;gap:6px;align-items:center;text-transform:none;letter-spacing:0;font-size:12px;color:#e8eef6"><input id="flagTies" type="checkbox" checked> Hurricane ties</label>
  </div>
  <div class="btns">
    <button class="btn-gold" type="button" onclick="applyVillage()">Apply Village Codes</button>
    <button class="btn-white" type="button" onclick="loadVillagePacket(true)">Load village packet</button>
    <button class="btn-white" type="button" onclick="buildPlans()">Generate Plans</button>
    <button class="btn-gold" type="button" onclick="window.print()">Print plans</button>
    <button class="btn-ghost" type="button" onclick="saveJob()">Save Job</button>
    <button class="btn-ghost" type="button" onclick="showJobs()">Previous Jobs</button>
    <button class="btn-ghost" type="button" onclick="openVillageSite()">Village Building Dept</button>
    <button class="btn-ghost" type="button" onclick="location.href='index.html'">Dashboard</button>
  </div>
  <div class="loadbar" id="loadBar">Looking up this village’s garage packet…</div>
  <div class="codes" id="codeBox">Select a village, Apply Village Codes, then Load village packet (needs wifi).</div>
  <div class="codes" id="ruleBox">Job rules update when size, door, returns, walls, or setbacks change.</div>
</aside>
<main class="main">
  <div class="toolbar no-print">
    <h2>Official Garage Permit Plans</h2>
    <div class="small">Each Generate uses only this job’s size, roof, doors, landing, outlets, and village. Nothing is copied from a previous plan.</div>
  </div>
  <div class="sheet-wrap" id="pages"></div>
</main>
