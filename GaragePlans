let planItems=[], planHist=[], selectedItem=null;
function itemId(){return 'i'+Date.now()+Math.floor(Math.random()*99)}
function seedPlanItems(){
  const want=Math.max(0, Math.min(8, gfiQty()));
  let gfis=planItems.filter(i=>i.type==='gfi');
  const others=planItems.filter(i=>i.type!=='gfi');
  if(gfis.length===want) return;
  const spots=[{x:26,y:36},{x:68,y:36},{x:26,y:72},{x:68,y:72},{x:47,y:28},{x:47,y:78},{x:20,y:54},{x:74,y:54}];
  while(gfis.length<want){
    const i=gfis.length;
    const s=spots[i]||{x:30+(i%4)*12,y:40+Math.floor(i/4)*14};
    gfis.push({id:itemId(),type:'gfi',x:s.x,y:s.y,w:6,h:7,text:'GFI'});
  }
  if(gfis.length>want) gfis=gfis.slice(0,want);
  planItems=others.concat(gfis);
}
function pushHist(){ planHist.push(JSON.stringify(planItems)); if(planHist.length>40) planHist.shift(); }
function renderOverlay(){
  const layer=$('floorOverlay'); if(!layer) return;
  layer.innerHTML=planItems.map(it=>{
    const sel=selectedItem===it.id?' sel':'';
    if(it.type==='gfi') return `<div class="ov gfi${sel}" data-id="${it.id}" style="left:${it.x}%;top:${it.y}%">${esc(it.text||'GFI')}</div>`;
    if(it.type==='txt') return `<div class="ov txt${sel}" data-id="${it.id}" contenteditable="true" style="left:${it.x}%;top:${it.y}%">${esc(it.text||'TEXT')}</div>`;
    if(it.type==='box') return `<div class="ov box${sel}" data-id="${it.id}" style="left:${it.x}%;top:${it.y}%;width:${it.w||12}%;height:${it.h||8}%"></div>`;
    if(it.type==='line') return `<div class="ov line${sel}" data-id="${it.id}" style="left:${it.x}%;top:${it.y}%;width:${it.w||18}%"></div>`;
    return '';
  }).join('');
  bindOverlay();
}
function bindOverlay(){
  const host=$('floorHost'); if(!host) return;
  host.querySelectorAll('.ov').forEach(el=>{
    el.onpointerdown=e=>{
      if(el.classList.contains('txt') && e.detail>1) return;
      e.preventDefault();
      selectedItem=el.dataset.id;
      host.querySelectorAll('.ov').forEach(n=>n.classList.toggle('sel', n.dataset.id===selectedItem));
      const it=planItems.find(x=>x.id===selectedItem); if(!it) return;
      const r=host.getBoundingClientRect();
      const sx=e.clientX, sy=e.clientY, ox=it.x, oy=it.y;
      let moved=false;
      const move=ev=>{
        moved=true;
        it.x=Math.max(0,Math.min(92, ox+(ev.clientX-sx)/r.width*100));
        it.y=Math.max(0,Math.min(92, oy+(ev.clientY-sy)/r.height*100));
        el.style.left=it.x+'%'; el.style.top=it.y+'%';
      };
      const up=()=>{
        window.removeEventListener('pointermove',move);
        window.removeEventListener('pointerup',up);
        if(moved) pushHist();
      };
      window.addEventListener('pointermove',move);
      window.addEventListener('pointerup',up);
    };
    if(el.classList.contains('txt')){
      el.oninput=()=>{ const it=planItems.find(x=>x.id===el.dataset.id); if(it) it.text=el.textContent; };
    }
  });
}
function toolAddText(){ pushHist(); planItems.push({id:itemId(),type:'txt',x:40,y:20,text:'NOTE'}); renderOverlay(); }
function toolAddRect(){ pushHist(); planItems.push({id:itemId(),type:'box',x:40,y:40,w:16,h:10}); renderOverlay(); }
function toolAddLine(){ pushHist(); planItems.push({id:itemId(),type:'line',x:30,y:50,w:20}); renderOverlay(); }
function toolAddGfi(){ pushHist(); planItems.push({id:itemId(),type:'gfi',x:50,y:50,text:'GFI'}); const n=planItems.filter(i=>i.type==='gfi').length; if($('gfiCount')) $('gfiCount').value=String(n); renderOverlay(); }
function toolUndo(){ if(!planHist.length) return; planItems=JSON.parse(planHist.pop()); selectedItem=null; renderOverlay(); }
function toolDelete(){ if(!selectedItem) return; pushHist(); planItems=planItems.filter(i=>i.id!==selectedItem); selectedItem=null; if($('gfiCount')) $('gfiCount').value=String(planItems.filter(i=>i.type==='gfi').length); renderOverlay(); }
function makeSheetTextEditable(){
  document.querySelectorAll('.sheet .caption,.sheet .subcap,.sheet .notes-col,.sheet .tblock,.sheet .elecbox').forEach(el=>{
    el.setAttribute('contenteditable','true');
  });
}
function fitSheetsToPanel(){
  const main=document.querySelector('.main');
  if(!main) return;
  const avail=Math.max(320, main.clientWidth-8);
  document.querySelectorAll('.sheet-fit').forEach(wrap=>{
    const s=wrap.querySelector('.sheet'); if(!s) return;
    s.style.transform='none';
    wrap.style.height='auto';
    const w=s.offsetWidth||(17*96);
    const scale=Math.min(1, avail/w);
    s.style.transform=`scale(${scale})`;
    wrap.style.height=(s.offsetHeight*scale)+'px';
  });
}
function buildPlans(){
  const W=Number(val('width')), D=Number(val('depth'));
  if(!Number.isFinite(W)||W<=0||!Number.isFinite(D)||D<=0){
    alert('Enter garage width and depth (feet) before generating plans.');
    return;
  }
  applyJobRules();
  seedPlanItems();
  const pages=$('pages'); if(!pages) return;
  pages.innerHTML=pageFloorSection()+pageElevations()+pageSectionRoof()+pageDetail()+pageFire();
  document.querySelectorAll('#pages > .sheet').forEach(s=>{
    const wrap=document.createElement('div');
    wrap.className='sheet-fit';
    s.parentNode.insertBefore(wrap,s);
    wrap.appendChild(s);
  });
  renderOverlay();
  makeSheetTextEditable();
  fitSheetsToPanel();
  bindDoorDrag();
}
function bindDoorDrag(){
  document.querySelectorAll('.drag-door').forEach(g=>{
    g.addEventListener('pointerdown', ev=>{
      ev.preventDefault();
      ev.stopPropagation();
      const kind=g.getAttribute('data-kind');
      const svg=g.closest('svg');
      const move=e=>{
        const rect=svg.getBoundingClientRect();
        const sx=((e.clientX-rect.left)/Math.max(rect.width,1))*520;
        const u=Math.max(0, Math.min(1, (sx-50)/360));
        if(kind==='oh'){
          const r=doorReturns();
          let L=+(u*r.W - r.oh/2).toFixed(1);
          L=Math.max(0, Math.min(+(r.W-r.oh).toFixed(1), L));
          if($('ohLeftReturn')) $('ohLeftReturn').value=L;
        } else {
          const pr=partyReturns();
          let L=+(u*pr.span - pr.w/2).toFixed(1);
          L=Math.max(0, Math.min(+(pr.span-pr.w).toFixed(1), L));
          if($('partyLeftReturn')) $('partyLeftReturn').value=L;
        }
        buildPlans();
      };
      const up=()=>{ window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up); };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
    });
  });
}
window.addEventListener('resize', fitSheetsToPanel);
function snapshot(){
  const o={};
  document.querySelectorAll('.sidebar input,.sidebar select,.sidebar textarea').forEach(el=>{
    if(!el.id) return;
    o[el.id]=el.type==='checkbox'?el.checked:el.value;
  });
  o._planItems=planItems;
  return o;
}
function restore(o){
  Object.keys(o||{}).forEach(k=>{
    if(k==='_planItems') return;
    const el=$(k); if(!el) return;
    if(el.type==='checkbox') el.checked=!!o[k]; else el.value=o[k];
  });
  if(Array.isArray(o._planItems)) planItems=o._planItems;
  buildPlans();
}
function saveJob(){
  const name=prompt('Save as customer / job name', val('customer')||'Untitled');
  if(!name) return;
  let jobs;
  try{ jobs=JSON.parse(localStorage.getItem('agb_garageplans_jobs')||'[]'); if(!Array.isArray(jobs)) jobs=[]; }
  catch(e){ jobs=[]; }
  const data=snapshot();
  const idx=jobs.findIndex(j=>j && j.name===name);
  const entry={id:(idx>=0&&jobs[idx].id)||Date.now(),name,when:new Date().toISOString(),data};
  if(idx>=0) jobs[idx]=entry; else jobs.unshift(entry);
  const write=list=>{ localStorage.setItem('agb_garageplans_jobs', JSON.stringify(list)); };
  try{
    write(jobs.slice(0,80));
    alert('Saved '+name);
  }catch(err){
    try{
      write(jobs.slice(0,20));
      alert('Saved '+name+' (trimmed older jobs — storage was full)');
    }catch(e2){
      alert('Could not save — browser storage is full. Open Previous Jobs, load what you need, or clear site data for this page.');
    }
  }
}
function showJobs(){
  let jobs;
  try{ jobs=JSON.parse(localStorage.getItem('agb_garageplans_jobs')||'[]'); if(!Array.isArray(jobs)) jobs=[]; }
  catch(e){ jobs=[]; alert('Saved jobs data was corrupt and could not be read.'); return; }
  if(!jobs.length){alert('No saved garage plan jobs on this device.');return;}
  const pick=prompt('Open job #\n'+jobs.map((j,i)=>(i+1)+'. '+j.name+'  ('+(j.when||'').slice(0,10)+')').join('\n'));
  const n=Number(pick)-1;
  if(jobs[n] && jobs[n].data) restore(jobs[n].data);
}

document.addEventListener('DOMContentLoaded',()=>{
  fillCitySelect();
  if($('planDate')&&!$('planDate').value) $('planDate').value=new Date().toISOString().slice(0,10);
  document.querySelectorAll('.sidebar input,.sidebar select,.sidebar textarea').forEach(el=>{
    el.addEventListener('change',()=>{
      if(el.id==='winWall' && el.value!=='none' && Number(val('winCount'))===0) $('winCount').value='1';
      if(el.id==='winWall' && el.value==='none') $('winCount').value='0';
      if(el.id==='winType'){
        if(/slider/i.test(el.value)) $('winSize').value='4x2';
        else if(/single/i.test(el.value)) $('winSize').value='2x3';
      }
      if(el.id==='winWall' && el.value!=='none' && !val('winSize')){
        $('winSize').value=/slider/i.test(val('winType'))?'4x2':'2x3';
      }
      if(el.id==='partyWall' && el.value!=='none' && !val('partySize')) $('partySize').value='6x7';
      if(el.id==='svcWall' && el.value==='none') $('landing').value='';
      if(el.id==='city') applyVillage();
      else buildPlans();
    });
  });
  ['ohSlide','partySlide'].forEach(id=>{
    const el=$(id);
    if(!el) return;
    el.addEventListener('input',()=>{
      if(id==='ohSlide' && $('ohLeftReturn')) $('ohLeftReturn').value=el.value;
      if(id==='partySlide' && $('partyLeftReturn')) $('partyLeftReturn').value=el.value;
      buildPlans();
    });
  });
  buildPlans();
});
</script>
