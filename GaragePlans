function cityStruct(){
  const name=cityName();
  const N=String(((code()||{}).notes)||'').toUpperCase();
  const s={alwaysBrace:false,cutoffFt:4,minReturnIn:12,roofSheath:'',wallSheath:'',hurricane:false,gutters:null,vapor:false,rebar:false,landing:false,housewrap:false,noGutters:false,noFire:false};
  const known={
    'Addison':{cutoffFt:4},
    'Antioch':{cutoffFt:32/12,roofSheath:'5/8" PLYWOOD ROOF'},
    'Evanston':{cutoffFt:2},
    'Forest Park':{alwaysBrace:true,minReturnIn:16,roofSheath:'5/8" ROOF SHEATHING'},
    'DeKalb County':{alwaysBrace:true},
    'Mundelein':{alwaysBrace:true},
    'Bartlett':{roofSheath:'5/8" PLYWOOD ROOF',hurricane:true},
    'Bedford Park':{gutters:true},
    'Bolingbrook':{hurricane:true},
    'Blue Island':{housewrap:true},
    'Cicero':{noGutters:true,roofSheath:'5/8" PLYWOOD ROOF'},
    'Evergreen Park':{vapor:true},
    'Geneva':{landing:true},
    'Gurnee':{landing:true},
    'Bensenville':{landing:true},
    'Aurora':{rebar:true},
    'Elmwood Park':{rebar:true},
    'Arlington Heights':{hurricane:true}
  };
  Object.assign(s, known[name]||{});
  let m=N.match(/RETURNS?\s+(?:ARE\s+)?(?:LESS THAN|UNDER)\s+(\d+)/);
  if(m){ const v=Number(m[1]); s.cutoffFt=v>=12?v/12:v; }
  m=N.match(/LESS THAN\s+(\d+)\s*"/);
  if(m) s.cutoffFt=Number(m[1])/12;
  if(/PORTAL|METHOD PFG|PFG PORTAL/.test(N)) s.alwaysBrace=true;
  if(/BRACED SHORT WALL/.test(N)) s.alwaysBrace=true;
  if(/AVOID SHEER|AVOID SHEAR/.test(N)){
    const m2=N.match(/MINIMUM\s+(\d+)\s*'/); if(m2) s.cutoffFt=Number(m2[1]);
  }
  if(/NO FIRE WALL/.test(N)) s.noFire=true;
  if(/GUTTERS REQUIRED/.test(N)) s.gutters=true;
  if(/DO NOT PUT ON GUTTERS/.test(N)) s.noGutters=true;
  if(/HURICAN|HURRICANE|H CLIPS|H-CLIPS/.test(N)) s.hurricane=true;
  if(/VAPOR/.test(N)) s.vapor=true;
  if(/REBAR/.test(N)) s.rebar=true;
  if(/3\s*X\s*3 LANDING|3X3 LANDING/.test(N)) s.landing=true;
  if(/HOUSE WRAP/.test(N)) s.housewrap=true;
  if(/5\/8/.test(N) && /ROOF/.test(N)) s.roofSheath=s.roofSheath||'5/8" ROOF SHEATHING';
  const pkt=packet();
  if(pkt && Number(pkt.braceReturnFt)>0) s.cutoffFt=Number(pkt.braceReturnFt);
  if(pkt && pkt.flags){
    if(pkt.flags.shear && !pkt.flags.braceIfShortReturns) s.alwaysBrace=true;
    if(pkt.flags.hurricane) s.hurricane=true;
    if(pkt.flags.gutters) s.gutters=true;
    if(pkt.flags.vapor) s.vapor=true;
  }
  return s;
}
function braceCutoffFt(){ return cityStruct().cutoffFt; }
function cityForcesBrace(){ return !!cityStruct().alwaysBrace; }
function computeBraceRequired(){
  const r=doorReturns();
