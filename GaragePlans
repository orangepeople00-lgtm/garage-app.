function computeFirewallRequired(){
  if(cityStruct().noFire) return false;
  const p=packet();
  if(p && p.flags && p.flags.firewall) return true;
  const c=code()||{};
  const blob=[c.notes,c.setHouse,c.setSide,c.setRearNoAlley].join(' ');
  if(/NO FIRE WALL/i.test(blob)) return false;
  if(/FIRE\s*WALL/i.test(c.notes||'') && !/NO FIRE/i.test(c.notes||'')) return true;
  const house=parseFt(val('setHouse')) ?? parseFt(c.setHouse);
