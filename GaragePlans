  const rear=parseFt(val('setRearN')) ?? parseFt(c.setRearNoAlley);
  if(/5\/8|DRYWALL/i.test(c.setHouse||'') && house!=null && house<10) return true;
  if(house!=null && house<6) return true;
  if(side!=null && side<3) return true;
  if(rear!=null && rear<3) return true;
  return false;
}
