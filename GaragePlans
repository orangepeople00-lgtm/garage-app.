function code(){
  let base=CITY_CODE_SHEETS[val('city')]||null;
  if(!base){
    const n=cityName();
    if(n && n!=='Village' && n!=='Other'){
      base=CITY_CODE_SHEETS[n]||null;
      if(!base){
        const hit=Object.keys(CITY_CODE_SHEETS).find(k=>k.toLowerCase()===n.toLowerCase());
        if(hit) base=CITY_CODE_SHEETS[hit];
      }
    }
  }
  const p=packet();
  if(!base && !p) return null;
  const o=Object.assign({}, base||{});
  if(p){
    if(p.rafters) o.rafters=p.rafters;
    if(p.ohHeader) o.ohHeader=p.ohHeader;
    if(p.footings) o.footings=p.footings;
    if(p.slab) o.slab=p.slab;
    if(p.maxSize) o.maxSize=p.maxSize;
    if(p.maxHeight) o.height=p.maxHeight;
    if(p.wallSheath) o.wallSheath=p.wallSheath;
    if(p.roofSheath) o.roofSheath=p.roofSheath;
    if(Array.isArray(p.extraNotes) && p.extraNotes.length){
      o.notes=[o.notes||'', p.extraNotes.join(' ')].filter(Boolean).join(' ');
    }
  }
  return o;
}
